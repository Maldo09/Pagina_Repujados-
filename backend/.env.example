# Copia este archivo como .env y cambia los valores

# Conexión a PostgreSQL:  postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:tu_clave@localhost:5432/repujados

# Clave para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Clave interna de Flask (cualquier texto largo y aleatorio)
SECRET_KEY=pon-aqui-un-texto-largo-y-aleatorio

# Número de WhatsApp con indicativo de país (sin + ni espacios)
WHATSAPP=573148594677
